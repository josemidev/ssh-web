---
import Button from "./button.astro";
---

<nav id="nav" class="fixed bg-white py-4 z-50 w-full">
    <div class="flex justify-between items-center lg:max-w-7xl lg:mx-auto px-5 lg:px-0">
        <button onclick="scrollToSection('hero')" class="outline-none cursor-pointer">
            <img 
                src="/images/smart_rate.webp" 
                alt="Logo Smart Rate"
                loading="eager"
            >
        </button>

        <Button 
            text="Call now"
            className="!py-3"
            link="tel:+12104852325"
        >
    </div>
</nav>

<style>

#nav{
   animation: shadow linear both; 
   animation-timeline: scroll();
   animation-range: 0 500px;
}

@keyframes shadow {
    to {
        box-shadow: 
        0 10px 15px -3px rgb(0 0 0 / 0.1), 
        0 4px 6px -4px rgb(0 0 0 / 0.1);
    }
}
</style>