---
import Form from "@/components/form"
---

<section id="hero" class="bg-main pt-[150px] pb-[380px] lg:pb-[230px]">
    <div class="size-screen col gap-[26px] text-white relative">
        <h1 class="title text-center lg:text-start ">
            Powering Your <br class="br-hidden">
            Savings Smartly…
        </h1>

        <p class="paragraph [&>span]:font-semibold br-hidden">
            <span>Welcome to SmartRate Energy!</span> <br>
            Your best partner for minimizing energy costs and <br>
            optimizing your services.  
        </p>

        <p class="paragraph br-hidden">
            With our automatic savings system, we monitor the <br>
            market for you and adjust your rates so you always pay <br>
            the fair price — hassle-free.
        </p>

        <p class="paragraph text-center lg:text-start lg:hidden">
            If you need support, we have programs <br>
            that can help - like our new Payment <br>
            Assistance Bundle.
        </p>

        <div class="px-4 lg:px-0 absolute top-[280px] lg:-top-10 right-0">
            <Form client:load />
        </div>
    </div>
</section>