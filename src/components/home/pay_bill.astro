---
import Button from "../button.astro";
import Faq from "../faq";
---

<section class="size-screen pt-[1000px] pb-[35px] lg:pt-[300px] lg:pb-[50px]">
    <div class="text-center col gap-6 mb-10">
        <h1 class="title">
            Pay Your Bill the <br class="br-hidden">
            Easy Way
        </h1>

        <p class="paragraph">
            We make it simple for you to stay on top of your <br class="br-hidden">
            payments. Choose from convenient options, <br class="br-hidden">
            including setting up a low monthly percentage <br class="br-hidden">
            payment plan that fits your budget. <br class="br-hidden">
            We also assist you with:
        </p>
    </div>

    <Faq type={1} client:only="react" />

     <Button 
        text="Call now"
        className="!py-3 flex justify-center items-center mx-auto"
        link="tel:+12108923660"
        ></Button>
</section>